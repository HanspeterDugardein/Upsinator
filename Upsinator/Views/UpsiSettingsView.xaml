<UserControl x:Class="Upsinator.Views.UpsiSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Upsinator.Views"
      xmlns:viewModels="clr-namespace:Upsinator.ViewModels"
      xmlns:logic="clr-namespace:Upsinator.Logic"
      xmlns:models="clr-namespace:Upsinator.Models"
      xmlns:customControls="clr-namespace:Upsinator.CustomControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="400" Name="Root">

    <UserControl.DataContext>
        <viewModels:UpsiSettingsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <ObjectDataProvider 
            x:Key="enumDataType" 
            MethodName="GetValues"
            ObjectType="{x:Type logic:EnumerationManager}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:ArgTypeEnum" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="35" />
                <RowDefinition Height="35" />
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- All labels on the left -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" Margin="5" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="PowerShell file" Margin="5" />
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Parameters" Margin="5" />

            <!-- All input elements on the right -->
            <!-- Title -->
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Model.Upsi.Title}" Margin="5" />

            <!-- Path to the Powershell script to execute with this upsi -->
            <customControls:FilePathPicker 
                Grid.Row="1"
                Grid.Column="1"
                Path="{Binding Model.Upsi.PowerShellScript}" 
                FileExtensionFilter="{Binding FileExtensionFilter}"
                Margin="5" />

            <!-- Dynamic args list -->
            <ScrollViewer Grid.Row="2" Grid.Column="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="185" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>
                    
                    <!-- Variable list of existing elements -->
                    <ItemsControl Grid.Row="0" ItemsSource="{Binding Model.Upsi.Args}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="32" />
                                        <!-- 2px more for the combobox to avoid clipping -->
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                    </Grid.RowDefinitions>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DisplayTitle}" FontWeight="Bold" Margin="5" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Label" Margin="5" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Value type" Margin="5" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Default value" Margin="5" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Is mandatory" Margin="5" />

                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Label}" Margin="5" />
                                    <ComboBox 
                                        Grid.Row="2" Grid.Column="1" Margin="5" 
                                        ItemsSource="{Binding Source={StaticResource enumDataType}}"
                                        SelectedItem="{Binding Path=ArgType}"
                                        SelectionChanged="ComboBox_SelectionChanged"/>
                                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="5">
                                        <!-- ArgTypeEnum.String -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter 
                                                Property="Visibility" 
                                                Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger
                                                            Binding="{Binding ArgType}"
                                                            Value="{x:Static models:ArgTypeEnum.String}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <TextBox Text="{Binding Value}" />
                                        </StackPanel>

                                        <!-- ArgTypeEnum.Folder -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger  
                                                            Binding="{Binding ArgType}"
                                                            Value="{x:Static models:ArgTypeEnum.Folder}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <customControls:FolderPathPicker Path="{Binding Value}" />
                                        </StackPanel>

                                        <!-- ArgTypeEnum.File -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter 
                                                Property="Visibility" 
                                                Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger 
                                                            Binding="{Binding ArgType}"
                                                            Value="{x:Static models:ArgTypeEnum.File}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <customControls:FilePathPicker Path="{Binding Value}" />
                                        </StackPanel>

                                        <!-- ArgTypeEnum.Date -->
                                        <StackPanel Grid.Column="1">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter 
                                                Property="Visibility" 
                                                Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger 
                                                            Binding="{Binding ArgType}"
                                                            Value="{x:Static models:ArgTypeEnum.Date}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>

                                            <customControls:DateTimeStringPicker Value="{Binding ValueDateTime}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!--<TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Value}" Margin="5" />-->
                                    <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding IsMandatory}" Margin="5" />

                                    <Button
                                        Grid.Row="5"
                                        Grid.Column="0"
                                        Content="Remove" 
                                        Command="{Binding Path=DataContext.RemoveArgumentCmd, ElementName=Root}"
                                        CommandParameter="{Binding Id}"
                                        Margin="5" />

                                    <Border BorderThickness="0, 0, 0, 1" BorderBrush="Gray" Grid.ColumnSpan="2" Grid.Row="5" />

                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- New argument -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <!-- 2px more for the combobox to avoid clipping -->
                            <RowDefinition Height="32" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border BorderThickness="0, 20, 0, 0" BorderBrush="Gray" Grid.ColumnSpan="2" Grid.Row="0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="New argument" FontWeight="Bold" Margin="5" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Label" Margin="5" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Default value" Margin="5" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Is mandatory" Margin="5" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Value type" Margin="5" />

                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Model.NewUpsiArg.Label}" Margin="5" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Model.NewUpsiArg.Value}" Margin="5" />
                        <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Model.NewUpsiArg.IsMandatory}" Margin="5" />
                        <ComboBox 
                            Grid.Row="5" Grid.Column="1" Margin="5" 
                            ItemsSource="{Binding Source={StaticResource enumDataType}}"
                            SelectedItem="{Binding Path=Model.NewUpsiArg.ArgType}" />

                        <Button 
                            Grid.Row="6"
                            Grid.Column="0"
                            Content="Add" 
                            Command="{Binding AddNewArgumentCmd}" 
                            Margin="5" />

                        <Border BorderThickness="0, 0, 0, 1" BorderBrush="Gray" Grid.ColumnSpan="2" Grid.Row="6" />
                    </Grid>
                </Grid>
            </ScrollViewer>
            
            <!-- Save / discard buttons -->
            <Button 
                Command="{Binding SaveSettingsCmd}"
                Content="Save new settings" 
                Margin="5" 
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="2" />

            <Button
                Command="{Binding ResetSettingsCmd}"
                Content="Discard changes"
                Margin="5"
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2" />
        </Grid>
        
        
        <Grid Grid.Row="1" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        
            <!-- Title -->
            <StackPanel Orientation="Vertical" Margin="5" Grid.Row="0">
                <TextBlock Text="Title" />
            
                <TextBox Text="{Binding Model.Upsi.Title}" />
            </StackPanel>
        
            <!-- PowerShell script -->
            <StackPanel Orientation="Vertical" Margin="5" Grid.Row="1">
                <TextBlock Text="PowerShell file" />

                <customControls:FilePathPicker 
                        Grid.Row="1" 
                        Grid.ColumnSpan="2" 
                        Path="{Binding Model.Upsi.PowerShellScript}" 
                        FileExtensionFilter="{Binding FileExtensionFilter}" />
            </StackPanel>

            <!-- Dynamic args list -->
            <ScrollViewer Margin="5" Grid.Row="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                
                    <StackPanel 
                        Name="stackPanel"
                        Grid.Row="0">
                    
                        <ItemsControl ItemsSource="{Binding Model.Upsi.Args}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <GroupBox>
                                        <GroupBox.Header>
                                            <TextBlock Text="{Binding DisplayTitle}" />
                                        </GroupBox.Header>

                                        <StackPanel>
                                            <StackPanel Margin="5">
                                                <TextBlock Text="Label" />
                                                <TextBox Text="{Binding Label}" />
                                            </StackPanel>

                                            <StackPanel Margin="5">
                                                <TextBlock Text="Default value" />
                                                <TextBox Text="{Binding Value}" />
                                            </StackPanel>

                                            <StackPanel Margin="5">
                                                <TextBlock Text="Mandatory" />
                                                <CheckBox IsChecked="{Binding IsMandatory}" />
                                            </StackPanel>

                                            <StackPanel Margin="5">
                                                <TextBlock Text="Type" />
                                                <ComboBox 
                                                    ItemsSource="{Binding Source={StaticResource enumDataType}}"
                                                    SelectedItem="{Binding Path=ArgType}" />
                                            </StackPanel>

                                            <Button 
                                                Content="Remove" 
                                                Command="{Binding Path=DataContext.RemoveArgumentCmd, ElementName=Root}"
                                                CommandParameter="{Binding Id}"
                                                Margin="5" />
                                        </StackPanel>
                                    </GroupBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator Height="40" />

                        <!-- Todo make UserControl -->
                        <GroupBox>
                            <GroupBox.Header>
                                <TextBlock Text="New argument" />
                            </GroupBox.Header>

                            <StackPanel>
                                <StackPanel Margin="5">
                                    <TextBlock Text="Label" />
                                    <TextBox Text="{Binding Model.NewUpsiArg.Label}" />
                                </StackPanel>

                                <StackPanel Margin="5">
                                    <TextBlock Text="Default value" />
                                    <TextBox Text="{Binding Path=Model.NewUpsiArg.Value, Mode=TwoWay}" />
                                </StackPanel>

                                <Button 
                                    Content="Add" 
                                    Command="{Binding AddNewArgumentCmd}" 
                                    Margin="5" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <Button 
                    Command="{Binding SaveSettingsCmd}"
                    Content="Save new settings" 
                    Margin="5" 
                    Grid.Row="1" />

                    <Button
                    Command="{Binding ResetSettingsCmd}"
                    Content="Discard changes"
                    Margin="5"
                    Grid.Row="2" />
                </Grid>
            </ScrollViewer>
        </Grid>

    </Grid>
</UserControl>
