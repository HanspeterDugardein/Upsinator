using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Linq;
using System.Runtime.CompilerServices;
using System.Text;
using System.Threading.Tasks;

namespace Upsinator.Models
{
    public class UpsinatorModel : INotifyPropertyChanged
    {
        private UpsiModel _model;

        public string FilePathUpsi { get; set; }

        public UpsiModel Upsi
        {
            get
            {
                return this._model;
            }
            set
            {
                this._model = value;

                this.NotifyPropertyChanged(nameof(this.Upsi));
            }
        }

        public UpsinatorModel()
        {
            this.FilePathUpsi = "Uninitialized_filepath";

            this._model = new UpsiModel();
        }

        public event PropertyChangedEventHandler? PropertyChanged;

        private void NotifyPropertyChanged([CallerMemberName] String propertyName = "")
        {
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));
        }
    }
}
