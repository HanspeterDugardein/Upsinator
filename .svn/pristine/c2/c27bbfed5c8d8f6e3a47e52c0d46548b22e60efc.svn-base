<Window x:Class="Upsinator.Views.UpsinatorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:Upsinator.ViewModels"
        xmlns:local="clr-namespace:Upsinator.Views"
        mc:Ignorable="d"
        Title="UpsinatorView" Height="450" Width="800">

    <Window.DataContext>
        <viewModels:UpsinatorViewModel />
    </Window.DataContext>

    <Grid>
        <GroupBox>
            <GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderThickness="0" BorderBrush="#000" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="/Resources/settings-icon-3.png" Width="20" Height="20" Grid.Column="0" />
                    </Border>
                    <TextBlock Text="{Binding Model.Upsi.Title}" Grid.Column="1" Margin="5, 0, 0, 0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </GroupBox.Header>

            <StackPanel>
                <ItemsControl ItemsSource="{Binding Model.Upsi.Args}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="5">
                                <TextBlock Text="{Binding Label}" />
                                <TextBox Text="{Binding Value}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Margin="5" Command="{Binding ExecuteCmd}">Execute</Button>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
